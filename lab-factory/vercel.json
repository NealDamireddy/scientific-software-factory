{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{src/labfactory/**,examples/*.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/mcp", "destination": "/api/index"},
    {"source": "/mcp/", "destination": "/api/index"},
    {"source": "/api/:path*", "destination": "/api/index"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
    ]}
  ]
}
