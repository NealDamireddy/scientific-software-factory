{
  "name": "scientific-software-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "dev:evolve": "next dev",
    "build": "next build",
    "build:lab": "node lab-factory/scripts/build_portal.mjs",
    "prestart": "npm run build:lab",
    "start": "uv run --locked --project lab-factory python lab-factory/scripts/serve_portal.py",
    "prebuild": "node scripts/prepare-web.mjs",
    "predev:evolve": "node scripts/prepare-web.mjs",
    "test": "playwright test",
    "test:lab": "playwright test --config playwright.integrated.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pyodide": "314.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
