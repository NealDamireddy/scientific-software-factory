{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public instrument profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "wavelengths_nm", "path_lengths_mm", "replicate_limits", "operations", "blank_reference_required", "simulated"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[1-9][0-9]*$"},
    "wavelengths_nm": {"$ref": "#/$defs/positive_values"},
    "path_lengths_mm": {"$ref": "#/$defs/positive_values"},
    "replicate_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 1},
        "max": {"type": "integer", "minimum": 1}
      }
    },
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "blank_reference_required": {"type": "boolean"},
    "simulated": {"type": "boolean"}
  },
  "$defs": {
    "positive_values": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "number", "exclusiveMinimum": 0}
    }
  }
}
