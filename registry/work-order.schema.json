{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "lab": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "instrument": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "local",
        "8090"
      ]
    },
    "upstream_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "behavior": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
      },
      "uniqueItems": true
    },
    "input": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minProperties": 1,
          "maxProperties": 8
        }
      },
      "required": [
        "dataset",
        "units"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true
    },
    "review": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "id",
    "lab",
    "project",
    "instrument",
    "origin",
    "objective",
    "behavior",
    "operations",
    "input",
    "parameters",
    "acceptance",
    "verification",
    "review"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "origin": {
        "const": "8090"
      }
    }
  },
  "then": {
    "required": [
      "upstream_id"
    ]
  }
}
