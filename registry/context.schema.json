{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab and project context payloads v1",
  "oneOf": [{"$ref": "#/$defs/lab"}, {"$ref": "#/$defs/project"}],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "texts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "instrument": {
      "type": "object", "additionalProperties": false,
      "required": ["instrument_id", "lab_id", "profile_id", "profile_sha256"],
      "properties": {
        "instrument_id": {"$ref": "#/$defs/id"},
        "lab_id": {"$ref": "#/$defs/id"},
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[1-9][0-9]*$"},
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lab": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "lab_id", "name", "instruments", "approved_libraries", "operating_restrictions"],
      "properties": {
        "schema_version": {"const": 1},
        "lab_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "instruments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instrument"}},
        "approved_libraries": {"$ref": "#/$defs/texts"},
        "operating_restrictions": {"$ref": "#/$defs/texts"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "project_id", "lab_id", "instrument_id", "scientific_objective", "protocol_id", "protocol_revision", "units", "analysis_method", "validation_criteria"],
      "properties": {
        "schema_version": {"const": 1},
        "project_id": {"$ref": "#/$defs/id"},
        "lab_id": {"$ref": "#/$defs/id"},
        "instrument_id": {"$ref": "#/$defs/id"},
        "scientific_objective": {"$ref": "#/$defs/text"},
        "protocol_id": {"$ref": "#/$defs/id"},
        "protocol_revision": {"type": "integer", "minimum": 1},
        "units": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/text"}, "additionalProperties": {"$ref": "#/$defs/text"}
        },
        "analysis_method": {"$ref": "#/$defs/text"},
        "validation_criteria": {"$ref": "#/$defs/texts", "minItems": 1},
        "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "standards": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sample_id", "known_concentration"],
            "properties": {
              "sample_id": {"$ref": "#/$defs/id"},
              "known_concentration": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "measurement_settings": {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "wavelength_nm", "path_length_mm", "replicates"],
          "properties": {
            "operation": {"$ref": "#/$defs/text"},
            "wavelength_nm": {"type": "number", "exclusiveMinimum": 0},
            "path_length_mm": {"type": "number", "exclusiveMinimum": 0},
            "replicates": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
